    "@imgly/plugin-background-removal-web": "1.83.0",
    "@imgly/plugin-vectorizer-web": "^1.83.0",
    "onnxruntime-web": "1.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cesdk/node": "^1.83.0",
    "@imgly/pdfx-exporter": "^0.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
