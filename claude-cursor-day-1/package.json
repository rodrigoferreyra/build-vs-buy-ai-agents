{
  "name": "claude-cursor-day-1-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build -c vite.lib.config.ts && vite build",
    "preview": "vite preview",
    "build:lib": "vite build -c vite.lib.config.ts",
    "build:headless": "node headless/build.mjs",
    "render": "node headless/dist/canvasly-render.mjs",
    "build:android": "npm run build && bash mobile/android/build.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "imagetracerjs": "^1.2.6",
    "mediabunny": "^1.61.6",
    "onnxruntime-web": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
